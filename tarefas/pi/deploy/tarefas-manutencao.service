# Limpeza mensal: instâncias concluídas há mais de 90 dias (+ subscrições
# FCM inativas, enquanto a aba "Subscriptions" ainda não estiver deprecated).
[Unit]
Description=tarefas de casa — manutencao mensal
After=network-online.target

[Service]
Type=oneshot
User=bpereira
WorkingDirectory=/home/bpereira/tarefas/pi
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/bpereira/tarefas/pi/.venv/bin/python manutencao.py
