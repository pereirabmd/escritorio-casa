# Copia este ficheiro para .env (no RPi, dentro de tarefas/pi/) e preenche
# com os dados reais. NUNCA faças commit do .env para o git.

# --- Google Sheets (mesma service account já usada pelo bilhetes_cp — já
# tem acesso à pasta partilhada, não é preciso partilhar de novo) ---
GOOGLE_SERVICE_ACCOUNT_FILE=./config/service-account.json
GOOGLE_SHEET_ID=1ZwA9RqwCbOlfWLmYZWFsE5iq2oUqr-XZru_HDy6NjjI

# --- Encriptação das credenciais ntfy por pessoa, gravadas na aba Config
# (Pessoa{N}_NtfyPasswordEnc) — gerar UMA vez com:
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Perder esta chave torna as credenciais já guardadas irrecuperáveis (cada
# pessoa teria de as voltar a configurar pela app).
FERNET_KEY=

# --- Assinatura das ações "Marcar feita"/"Daqui a 1h" embutidas na própria
# notificação ntfy (ver recalcular.py: assinar_instancia) — qualquer string
# longa e aleatória; gerar com:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
ACAO_SEGREDO=

# --- ntfy (mesmo servidor self-hosted já montado para o bilhetes_cp) ---
NTFY_SERVER_URL=https://bmdpereira.duckdns.org
NTFY_TOPIC=tarefas
# Credencial de ESCRITA, só do Pi — nunca aparece na Sheet nem na PWA.
# Criar previamente no servidor ntfy:
#   sudo -u _ntfy ntfy user add tarefas-pi
#   sudo -u _ntfy ntfy access tarefas-pi tarefas rw
NTFY_WRITE_USER=tarefas-pi
NTFY_WRITE_PASSWORD=

# --- URL público deste serviço (usado para montar os links das ações da
# notificação — tem de bater certo com o location novo do nginx) ---
TAREFAS_API_URL=https://bmdpereira.duckdns.org/tarefas-api
TAREFAS_API_PORT=8899

# --- Timezone ---
TZ=Europe/Lisbon
