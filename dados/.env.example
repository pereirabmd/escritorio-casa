# Copia para .env (no Pi, dentro de ~/dados/) e preenche. NUNCA fazer commit do .env.

# Base de dados (por omissão: ./data/dados.db, ao lado do código)
# DADOS_DB=/home/bpereira/dados/data/dados.db

# --- API (api.py) ---
# CLIENT_ID(s) OAuth das apps (o mesmo das PWAs). Um token Google emitido para outro cliente é recusado.
GOOGLE_CLIENT_IDS=108256538530-fgunbb52s7f3s9aurfpjtaf01v8fjbph.apps.googleusercontent.com
# Quem pode usar cada app (e-mails Google separados por vírgula). Vazio = ninguém entra.
ACL_PESO=
# ACL_RTO=
# ACL_CONVIDADOS=
# ACL_TAREFAS=
# Administrador(es) fixo(s) da app tarefas (painel Admin): e-mails separados por vírgula. Os restantes escolhem-se na app.
# ADMIN_TAREFAS=pereirabmd@gmail.com
# Origens CORS permitidas (por omissão só o GitHub Pages)
# CORS_ORIGINS=https://pereirabmd.github.io
# Limites por minuto (por omissão: 120 por IP, 300 por utilizador, 10 falhas de auth por IP)
# RATE_IP_POR_MIN=120

# --- Backup para um repositório GitHub PRIVADO (nunca o escritorio-casa, que é público) ---
# Clone local desse repo privado (git clone git@github.com:<user>/<repo-privado>.git)
BACKUP_REPO_DIR=/home/bpereira/dados-backup
# Deploy key só com permissão de escrita nesse repo (ssh-keygen -t ed25519 -f ~/.ssh/dados_backup -N "")
BACKUP_SSH_KEY=/home/bpereira/.ssh/dados_backup
# Chave PÚBLICA age (começa por "age1..."). O Pi só cifra — a chave privada fica fora do Pi.
AGE_RECIPIENT=
# Tabelas que nunca entram no backup (separadas por vírgula)
BACKUP_EXCLUIR=

# --- Alerta ntfy se o backup falhar (publicar com a conta de escrita; Priority high) ---
NTFY_SERVER_URL=https://bmdpereira.duckdns.org
NTFY_BACKUP_TOPIC=backup
NTFY_WRITE_USER=
NTFY_WRITE_PASSWORD=

# --- Página web de consulta/edição das bases (admin_db.py; só rede local, porta 8890) ---
# Gerar com:  python3 admin_db.py --set-password   (imprime a linha abaixo)
# ADMIN_DB_PASSWORD_HASH=pbkdf2_sha256$...
# Redes autorizadas (por omissão qualquer endereço privado); a firewall também só abre a porta à LAN
# ADMIN_DB_REDES=192.168.68.0/24
# ADMIN_DB_PORT=8890
# ADMIN_DB_BIND=0.0.0.0
