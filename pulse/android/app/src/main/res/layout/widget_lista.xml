<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_raiz" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:paddingTop="12dp" android:paddingBottom="6dp" android:paddingStart="14dp" android:paddingEnd="14dp" android:background="@drawable/widget_bg">
    <TextView android:id="@+id/w_titulo" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingBottom="6dp"
        android:textColor="@color/widget_text" android:textSize="16sp" android:textStyle="bold" android:maxLines="1" />
    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <ListView android:id="@+id/w_lista" android:layout_width="match_parent" android:layout_height="match_parent" android:divider="@null" android:dividerHeight="0dp" />
        <TextView android:id="@+id/w_vazio" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center"
            android:textColor="@color/widget_text2" android:textSize="13sp" />
    </FrameLayout>
</LinearLayout>
