<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_raiz" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="horizontal" android:gravity="center_vertical" android:padding="14dp" android:background="@drawable/widget_bg">
    <ImageView android:layout_width="28dp" android:layout_height="28dp" android:src="@drawable/ic_widget_bilhete" android:contentDescription="Bilhete" />
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="12dp" android:orientation="vertical">
        <TextView android:id="@+id/w_titulo" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Próximo comboio"
            android:textColor="@color/widget_text2" android:textSize="12sp" android:maxLines="1" />
        <TextView android:id="@+id/w_linha1" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textColor="@color/widget_text" android:textSize="16sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" />
        <TextView android:id="@+id/w_linha2" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textColor="@color/widget_text2" android:textSize="12sp" android:maxLines="1" android:ellipsize="end" />
    </LinearLayout>
</LinearLayout>
