<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_raiz" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="horizontal" android:gravity="center_vertical" android:padding="14dp" android:background="@drawable/widget_bg">
    <LinearLayout android:id="@+id/w_peso_texto" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Peso" android:textColor="@color/widget_text2" android:textSize="12sp" />
        <TextView android:id="@+id/w_peso_valor" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/widget_text" android:textSize="22sp" android:textStyle="bold" android:maxLines="1" />
        <TextView android:id="@+id/w_peso_estado" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/widget_text2" android:textSize="11sp" android:maxLines="1" android:ellipsize="end" />
        <ImageView android:id="@+id/w_peso_grafico" android:layout_width="match_parent" android:layout_height="28dp" android:layout_marginTop="4dp" android:scaleType="fitCenter" android:contentDescription="Peso nos últimos 7 dias" />
    </LinearLayout>
    <TextView android:id="@+id/w_peso_botao" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:paddingStart="14dp" android:paddingEnd="14dp" android:paddingTop="10dp" android:paddingBottom="10dp"
        android:text="Registar" android:textColor="@color/widget_surface" android:textSize="13sp" android:textStyle="bold" android:background="@drawable/widget_botao" />
</LinearLayout>
