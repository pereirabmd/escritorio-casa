<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_raiz" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="14dp" android:background="@drawable/widget_bg">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
        <TextView android:id="@+id/w_titulo" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:text="Hoje" android:textColor="@color/widget_text" android:textSize="16sp" android:textStyle="bold" android:maxLines="1" />
        <LinearLayout android:id="@+id/w_tempo" android:layout_width="wrap_content" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
            <ImageView android:id="@+id/w_tempo_icone" android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_tempo_nublado" android:contentDescription="Tempo" />
            <TextView android:id="@+id/w_tempo_temp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="4dp"
                android:textColor="@color/widget_text" android:textSize="16sp" android:textStyle="bold" android:maxLines="1" />
            <TextView android:id="@+id/w_tempo_maxmin" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="6dp"
                android:textColor="@color/widget_text2" android:textSize="11sp" android:maxLines="1" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout android:id="@+id/w_linha_comboio" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="horizontal">
        <TextView android:layout_width="64dp" android:layout_height="wrap_content" android:text="Comboio" android:textColor="@color/widget_text2" android:textSize="12sp" />
        <TextView android:id="@+id/w_comboio" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:textColor="@color/widget_text" android:textSize="13sp" android:maxLines="1" android:ellipsize="end" />
    </LinearLayout>
    <LinearLayout android:id="@+id/w_linha_tarefas" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:orientation="horizontal">
        <TextView android:layout_width="64dp" android:layout_height="wrap_content" android:text="Tarefas" android:textColor="@color/widget_text2" android:textSize="12sp" />
        <TextView android:id="@+id/w_tarefas" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:textColor="@color/widget_text" android:textSize="13sp" android:maxLines="1" android:ellipsize="end" />
    </LinearLayout>
    <LinearLayout android:id="@+id/w_linha_rto" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:orientation="horizontal">
        <TextView android:layout_width="64dp" android:layout_height="wrap_content" android:text="RTO" android:textColor="@color/widget_text2" android:textSize="12sp" />
        <TextView android:id="@+id/w_rto" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:textColor="@color/widget_text" android:textSize="13sp" android:maxLines="1" android:ellipsize="end" />
    </LinearLayout>
    <LinearLayout android:id="@+id/w_linha_peso" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:orientation="horizontal">
        <TextView android:layout_width="64dp" android:layout_height="wrap_content" android:text="Peso" android:textColor="@color/widget_text2" android:textSize="12sp" />
        <TextView android:id="@+id/w_peso" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:textColor="@color/widget_text" android:textSize="13sp" android:maxLines="1" android:ellipsize="end" />
    </LinearLayout>

    <TextView android:id="@+id/w_rodape" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp"
        android:textColor="@color/widget_text2" android:textSize="10sp" android:maxLines="1" />
</LinearLayout>
