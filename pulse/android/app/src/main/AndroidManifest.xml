<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />   <!-- assistente de voz (ADR-077): o reconhecimento de fala é do Android -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />   <!-- o tempo do sítio onde estás (ADR-092): só localização aproximada -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />   <!-- avisos do Pulse (Android 13+) -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />   <!-- atualização interna (ADR-026) -->

    <queries>
        <intent><action android:name="android.speech.RecognitionService" /></intent>
        <intent><action android:name="android.intent.action.TTS_SERVICE" /></intent>   <!-- leitura por voz (ADR-080) -->
        <intent><action android:name="android.support.customtabs.action.CustomTabsService" /></intent>
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="false"
        android:usesCleartextTraffic="false"
        android:theme="@style/Theme.Pulse">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- toque longo no ícone da app (ADR-092): atalhos para a voz, o peso, os bilhetes, o RTO e as tarefas -->
            <meta-data android:name="android.app.shortcuts" android:resource="@xml/shortcuts" />
            <!-- regresso do consentimento da Google (ADR-051): pulse://google?resultado=ok|erro&motivo=… -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="pulse" android:host="google" />
            </intent-filter>
        </activity>

        <service android:name=".data.PulseMessagingService" android:exported="false">
            <intent-filter><action android:name="com.google.firebase.MESSAGING_EVENT" /></intent-filter>
        </service>
        <receiver android:name=".data.AcaoNotificacaoReceiver" android:exported="false" />
        <!-- widgets do ecrã inicial (ADR-092), no mesmo design da app -->
        <receiver android:name=".widgets.WidgetHoje" android:exported="true" android:label="@string/widget_hoje_nome">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_hoje_info" />
        </receiver>
        <receiver android:name=".widgets.WidgetTarefas" android:exported="true" android:label="@string/widget_tarefas_nome">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_tarefas_info" />
        </receiver>
        <receiver android:name=".widgets.WidgetCompras" android:exported="true" android:label="@string/widget_compras_nome">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_compras_info" />
        </receiver>
        <receiver android:name=".widgets.WidgetPeso" android:exported="true" android:label="@string/widget_peso_nome">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_peso_info" />
        </receiver>
        <receiver android:name=".widgets.WidgetVoz" android:exported="true" android:label="@string/widget_voz_nome">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_voz_info" />
        </receiver>
        <receiver android:name=".widgets.WidgetAcaoReceiver" android:exported="false" />
        <service android:name=".widgets.ListaTarefasService" android:permission="android.permission.BIND_REMOTEVIEWS" android:exported="false" />
        <service android:name=".widgets.ListaComprasService" android:permission="android.permission.BIND_REMOTEVIEWS" android:exported="false" />
        <activity android:name=".widgets.PesoRapidoActivity" android:exported="false" android:theme="@style/Theme.Pulse.Dialogo" android:excludeFromRecents="true" android:taskAffinity="" />
        <receiver android:name=".widgets.WidgetComboio" android:exported="true" android:label="@string/widget_comboio_nome">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_comboio_info" />
        </receiver>
        <meta-data android:name="com.google.firebase.messaging.default_notification_channel_id" android:value="pulse_geral" />
        <meta-data android:name="com.google.firebase.messaging.default_notification_icon" android:resource="@drawable/ic_stat_pulse" />
        <meta-data android:name="com.google.firebase.messaging.default_notification_color" android:resource="@color/notif_cor" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
