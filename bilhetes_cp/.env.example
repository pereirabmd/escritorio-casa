# Copia este ficheiro para .env e preenche com os dados reais.
# NUNCA faças commit do .env para o git (ver .gitignore).

# --- Conta CP (myCP) ---
CP_EMAIL=o-teu-email@exemplo.com
CP_PASSWORD=a-tua-password

# --- Dados do passageiro (para preencher a venda) ---
