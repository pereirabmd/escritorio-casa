# Copia este ficheiro para .env e preenche com os dados reais.
# NUNCA faças commit do .env para o git (ver .gitignore).

# --- Conta CP (myCP) ---
CP_EMAIL=o-teu-email@exemplo.com
CP_PASSWORD=a-tua-password

# --- Dados do passageiro (para preencher a venda) ---
CP_PASSENGER_NAME=Nome Completo Como No Cartao De Cidadao
CP_PASSENGER_CC=00000000
CP_PASSENGER_PHONE=PT9XXXXXXXX
CP_PASSENGER_NIF=000000000
CP_GREEN_PASS_NUMBER=0000000000

# --- Headers estáticos da API CP (ver PLANO_FINAL.md secção 2; recapturar de um
# HAR novo se deixarem de funcionar) ---
CP_CONNECT_ID=
CP_CONNECT_SECRET=
CP_API_KEY_TRAVEL=
CP_API_KEY_TICKETING=

# --- Google Sheets ---
GOOGLE_SERVICE_ACCOUNT_FILE=./config/service-account.json
GOOGLE_SHEET_ID=1PNY134CrkxVhcpKHjTDZMYqYv3q-_oeDusJ-hgLRMBk

# --- ntfy (self-hosted) ---
NTFY_SERVER_URL=https://bmdpereira.duckdns.org
NTFY_TOPIC=bpereira_cp
NTFY_USERNAME=bpereira
NTFY_PASSWORD=trocar-esta-password-antes-de-producao
# Opcional: ntfy local do RPi, usado se o URL público falhar (por omissão http://127.0.0.1:8080)
# NTFY_LOCAL_URL=http://127.0.0.1:8080

# --- Opcionais (PLANO_FINAL 2.3 e 2.4); deixar vazios até serem precisos ---
# JSON copiado do HAR, só se a CP recusar o passo fiscal sem morada:
# CP_FISCAL_ADDRESS=
# Reservado para o GET /trips (resolução do estado AMBÍGUO), ainda não usado:
# CP_CLIENT_REGISTRATION_DATE=
# Token de acesso do ntfy (em vez da password): `sudo -u _ntfy ntfy token add <utilizador>`
# NTFY_TOKEN=

# --- healthchecks.io: URL de ping do RPi (criar um check com período de 5 min) ---
HEALTHCHECKS_PING_URL=

# --- Timezone ---
TZ=Europe/Lisbon
