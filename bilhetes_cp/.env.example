CP_PASSENGER_CC=00000000
CP_PASSENGER_PHONE=PT9XXXXXXXX
CP_PASSENGER_NIF=000000000
CP_GREEN_PASS_NUMBER=0000000000

# --- Headers estáticos da API CP (ver PLANO.md secção 2; recapturar de um
# HAR novo se deixarem de funcionar) ---
CP_CONNECT_ID=
CP_CONNECT_SECRET=
CP_API_KEY_TRAVEL=
CP_API_KEY_TICKETING=

# --- Google Sheets ---
GOOGLE_SERVICE_ACCOUNT_FILE=./config/service-account.json
GOOGLE_SHEET_ID=1PNY134CrkxVhcpKHjTDZMYqYv3q-_oeDusJ-hgLRMBk

